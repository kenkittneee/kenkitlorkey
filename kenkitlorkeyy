local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local CorrectKey = "0973453703" 
local KeyInput = ""

local Success, Fluent = pcall(function()
    return loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
end)

if not Success then 
    warn("Khong the tai thu vien Fluent!")
    return 
end

local Window = nil

function StartMainScript()
    if game:GetService("CoreGui"):FindFirstChild("KenkitGui") then
        game:GetService("CoreGui").KenkitGui:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    local ImageButton = Instance.new("ImageButton")
    local UICorner = Instance.new("UICorner")

    ScreenGui.Parent = game:GetService("CoreGui")
    ScreenGui.Name = "KenkitGui"
    ScreenGui.ResetOnSpawn = false
    
    ImageButton.Parent = ScreenGui
    ImageButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ImageButton.Position = UDim2.new(0.1, 0, 0.15, 0)
    ImageButton.Size = UDim2.new(0, 55, 0, 55)
    ImageButton.Image = "rbxassetid://112847886551666"
    ImageButton.ZIndex = 10 

    UICorner.CornerRadius = UDim.new(1, 0) 
    UICorner.Parent = ImageButton

    local dragging, dragInput, dragStart, startPos
    ImageButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = ImageButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            ImageButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    Window = Fluent:CreateWindow({
        Title = "Kenkit Tổng Hợp",
        SubTitle = "by Gia Bao Dep Trai",
        TabWidth = 157,
        Size = UDim2.fromOffset(580, 400),
        Acrylic = true,
        Theme = "Dark",
        MinimizeKey = Enum.KeyCode.End
    })

    ImageButton.MouseButton1Click:Connect(function()
        Window:Minimize()
    end)

    local Tabs = {
        Main0 = Window:AddTab({ Title = "Thông Tin", Icon = "info" }),
        Main1 = Window:AddTab({ Title = "Script Farm", Icon = "box" }),
        Main2 = Window:AddTab({ Title = "Script Kaitun", Icon = "cpu" }),
        Main3 = Window:AddTab({ Title = "Script Pvp", Icon = "swords" }),
        Main4 = Window:AddTab({ Title = "Tsunami Escape", Icon = "waves" }),
        Main5 = Window:AddTab({ Title = "Script Meme Sea", Icon = "smile" })
    }

    Tabs.Main0:AddParagraph({Title = "Chào mừng!", Content = "Hệ thống đã sẵn sàng cho Gia Bảo!"})

    -- Buttons
    Tabs.Main1:AddButton({Title = "Trau v9", Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/trungdao2k4/buffalo/refs/heads/main/traurobloxv9.lua"))() end) end})
    Tabs.Main1:AddButton({Title = "Andepzai hub", Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/AnDepZaiHub/AnDepZaiHubBeta/refs/heads/main/AnDepZaiHubBeta.lua"))() end) end})
    Tabs.Main1:AddButton({Title = "Quantum hub" , Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/flazhy/QuantumOnyx/refs/heads/main/QuantumOnyx.lua"))() end) end})
    Tabs.Main2:AddButton({Title = "Kaitun (Lever)", Callback = function() pcall(function() loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/4365e6ab3c80828a24ba946f4d8ff946.lua"))() end) end})
    Tabs.Main3:AddButton({Title = "Hermanos hub", Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/hermanos-dev/hermanos-hub/refs/heads/main/Loader.lua"))() end) end})
    Tabs.Main4:AddButton({Title = "Cyrus hub", Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/CyrusOffc/scriptcyrus/refs/heads/main/roblox/loader.lua"))() end) end})
    Tabs.Main5:AddButton({Title = "Redz hub", Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/tlredz/Scripts/refs/heads/main/main.luau"))() end) end})

    Fluent:Notify({ Title = "Kenkit Hub", Content = "Đã mở Menu thành công!", Duration = 5 })
end

local KeyWindow = Fluent:CreateWindow({
    Title = "Hệ Thống Xác Thực",
    SubTitle = "Kenkit Hub - Protection",
    TabWidth = 160,
    Size = UDim2.fromOffset(600, 400),
    Acrylic = true,
    Theme = "Dark"
})

local KeyTab = KeyWindow:AddTab({ Title = "Nhập Key", Icon = "key" })

KeyTab:AddParagraph({
    Title = "Yêu cầu mã truy cập",
    Content = "Key: 0973453703"
})

KeyTab:AddInput("InputKey", {
    Title = "Vui lòng nhập Key:",
    Default = "",
    Placeholder = "Nhập mã tại đây...",
    Callback = function(Value)
        KeyInput = Value
    end
})

KeyTab:AddButton({
    Title = "Xác nhận",
    Callback = function()
        if KeyInput == CorrectKey then
            Fluent:Notify({ Title = "Thành công", Content = "Key chính xác!", Duration = 2 })
            KeyWindow:Destroy()
            task.wait(0.5)
            StartMainScript()
        else
            Fluent:Notify({ Title = "Thất bại", Content = "Sai mã Key!", Duration = 5 })
        end
    end
})

KeyWindow:SelectTab(1)
